{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClusterDeck",
  "version": "0.3.0",
  "identifier": "com.dasomel.clusterdeck",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "ClusterDeck",
        "width": 1120,
        "height": 740,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Switch, bootstrap, and verify Kubernetes environments on macOS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
