    "focusRing": { "value": "#38bdf8", "cssVariable": "--of-color-focus-ring" },
    "statusSuccess": { "value": "#22c55e", "cssVariable": "--of-color-status-success" },
    "statusWarning": { "value": "#f59e0b", "cssVariable": "--of-color-status-warning" },
