    "bgSurfaceSunken": { "value": "#0b0f16", "cssVariable": "--of-color-bg-subtle" },
    "bgSurfaceRaised": { "value": "#1e2b3e", "cssVariable": "--of-color-bg-surface-raised" },
    "textPrimary": { "value": "#f1f5f9", "cssVariable": "--of-color-text-primary" },
    "textSecondary": { "value": "#cbd5e1", "cssVariable": "--of-color-text-secondary" },
    "textMuted": { "value": "#94a3b8", "cssVariable": "--of-color-text-muted" },
    "borderDefault": { "value": "#28374d", "cssVariable": "--of-color-border-default" },
